# URLs (public site — same host serves API + dashboard in Docker/production)
WEB_URL=http://localhost:3001
API_URL=http://localhost:3001

# Production VPS extension build (set in root .env before npm run build:extension):
# WEB_URL=https://lif.remotepairnet.net
# API_URL=https://lif.remotepairnet.net

# Local development with Vite dev server:
# WEB_URL=http://localhost:5173
# API_URL=http://localhost:3001

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/li-facilitator

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# File storage (resumes, templates)
STORAGE_ROOT=./storage

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=

# Docker Compose local port mapping — host port the app container is
# published on (127.0.0.1 only). Default 3001.
# HOST_PORT=3001

# extension-scrape (LinkedIn job scraper extension)
SCRAPE_SENDER=li-job-scraper
SCRAPE_API_ENDPOINT=https://disyllabic-camille-tardily.ngrok-free.dev/api/expose/jobs
# SCRAPE_CHECK_API_ENDPOINT=https://disyllabic-camille-tardily.ngrok-free.dev/api/expose/jobs/check
