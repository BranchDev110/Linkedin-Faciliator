# Production environment — copy to deploy/env/production.env on the VPS
# Do not commit real secrets.

NODE_ENV=production
PORT=3001
# Public HTTPS port — kept at 3001 so users hit https://IP:3001
APP_PORT=3001

# Public URLs (must be https when behind nginx TLS)
WEB_URL=https://<VPS_PUBLIC_IP>:3001
API_URL=https://<VPS_PUBLIC_IP>:3001

MONGODB_URI=mongodb://mongo:27017/li-facilitator

JWT_SECRET=replace-with-long-random-production-secret
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

STORAGE_ROOT=/app/storage
CORS_ORIGINS=

# --- HTTPS / nginx (self-signed cert path on the VPS host) ---
# TLS_PATH must contain cert.pem and key.pem, owned by root.
# Generate once on the VPS (see README):
#   sudo mkdir -p /opt/lif/certs && cd /opt/lif/certs && \
#   sudo openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
#     -keyout key.pem -out cert.pem \
#     -subj "/CN=<VPS_PUBLIC_IP>" \
#     -addext "subjectAltName=IP:<VPS_PUBLIC_IP>"
TLS_PATH=/opt/lif/certs
NGINX_CONF=./deploy/nginx/li-facilitator-https.conf
