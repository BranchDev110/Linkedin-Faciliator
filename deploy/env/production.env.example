# Production environment — copy to deploy/env/production.env on the VPS
# Do not commit real secrets.

NODE_ENV=production
PORT=3001

# Host port the app container is published on (127.0.0.1 only).
# Host nginx reverse-proxies to http://127.0.0.1:${HOST_PORT}.
HOST_PORT=3001

# Public URLs (must be https — the host nginx terminates TLS via Certbot).
# Must match the server_name in /etc/nginx/sites-available/lif-app.conf.
WEB_URL=https://lif.remotepairnet.net
API_URL=https://lif.remotepairnet.net

MONGODB_URI=mongodb://mongo:27017/li-facilitator

JWT_SECRET=replace-with-long-random-production-secret
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

STORAGE_ROOT=/app/storage
CORS_ORIGINS=